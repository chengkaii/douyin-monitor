# ── DTK 容器（Evil0ctal v5）──────────────────────────────
DTK_BASE_URL=http://127.0.0.1:8000
DTK_API_KEY=dtk_replace_me

# v5.1.7 源码已确认的真实路径；实例版本不同时用 `npm run inspect-openapi` 核对后覆盖
# 占位符 {userId} / {cursor} 会在请求时替换；{} 形式只用于 path，query 参数用下面的 xxx_PARAM
DTK_POSTS_PATH=/api/v1/douyin/user/posts
DTK_POSTS_USER_PARAM=sec_user_id
DTK_POSTS_CURSOR_PARAM=cursor
DTK_POSTS_COUNT_PARAM=count
DTK_POSTS_COUNT=20
DTK_VIDEO_PATH=/api/v1/douyin/video
DTK_VIDEO_ID_PARAM=aweme_id
DTK_TASK_PATH=/api/v1/tasks/{taskId}
DTK_SYNC_WAIT=25
DTK_TIMEOUT_MS=30000

# ── 机房 IP 部署：住宅代理（可选）────────────────────────
# 留空 = DTK 直连抖音（本地 Mac / 住宅宽带场景）。
# Linux 服务器建议填住宅代理，避免机房 IP 被风控。支持 http/https/socks5/socks5h，
# 例：http://user:pass@proxy.example.com:8080
# 该值会作为 ?proxy= 传给 DTK，只影响「DTK → 抖音」的上游请求；
# 首次需把 DTK 的 security.request_proxy 开到 public，dtk:bootstrap 会自动做。
DTK_PROXY_URL=

# 夜间放宽窗口的时区。服务器常跑 UTC，不设会被错判；yaml 的 polling.timeZone 优先
POLLING_TIMEZONE=Asia/Shanghai

# ── 采集行为 ────────────────────────────────────────────
ACCOUNTS_FILE=./accounts.yaml
DB_PATH=./data/monitor.db
TMP_DIR=./data/tmp
SINK=local
# SINK=oss 时，产物写到 data/outbox/ 之外直接上 OSS；SINK=local 用于离线演练
OUTBOX_DIR=./data/outbox
# failed 自动重投：也可在 accounts.yaml 的 retry 段配置（yaml 优先）
RETRY_MAX_ATTEMPTS=5
RETRY_FAILED_EVERY_ROUNDS=20

# ── OSS（SINK=oss 才需要）───────────────────────────────
OSS_REGION=oss-cn-beijing
OSS_BUCKET=ffyc-creator
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PREFIX=douyin-monitor/

# ── 告警（可选）────────────────────────────────────────
WECOM_WEBHOOK=
